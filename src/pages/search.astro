---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/url';

// Pagefind 会在 `npm run build` 的第二步生成到 dist/pagefind/，运行时按 base 前缀拼出路径
const pagefindBase = href('pagefind/');
---

<BaseLayout title="搜索" description="在已收录的全部行业头条中全文检索，索引在构建期静态生成，无需后端。">
  <section class="border-b border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
      <nav class="text-xs text-gray-500 dark:text-slate-500">
        <a href={href('/')} class="hover:text-accent">首页</a>
        <span class="mx-2">/</span>
        <span class="text-gray-700 dark:text-slate-300">搜索</span>
      </nav>
      <h1 class="mt-3 text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">站内搜索</h1>
      <p class="mt-3 text-sm text-gray-600 dark:text-slate-400">
        索引由 Pagefind 在构建阶段静态生成，浏览器端直接检索，无后端、无外部请求。
        可搜索标题、摘要、来源与标签。
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8" data-pagefind-ignore>
    <div id="search" class="pagefind-host"></div>
    <noscript>
      <p class="text-sm text-gray-500 dark:text-slate-500">
        搜索需要启用 JavaScript。你也可以从
        <a href={href('daily')} class="text-accent-dark dark:text-accent">日报归档</a>
        按日期浏览全部条目。
      </p>
    </noscript>
  </section>
</BaseLayout>

<script is:inline define:vars={{ pagefindBase }}>
  (function () {
    var mount = document.getElementById('search');
    if (!mount) return;

    function boot() {
      if (!window.PagefindUI) return;
      new window.PagefindUI({
        element: '#search',
        bundlePath: pagefindBase,
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: '搜索标题、摘要、来源或标签…',
          zero_results: '没有匹配「[SEARCH_TERM]」的结果',
          many_results: '找到 [COUNT] 条与「[SEARCH_TERM]」相关的结果',
          one_result: '找到 1 条与「[SEARCH_TERM]」相关的结果',
          searching: '检索中…',
          load_more: '加载更多结果',
        },
      });
    }

    var css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = pagefindBase + 'pagefind-ui.css';
    document.head.appendChild(css);

    var script = document.createElement('script');
    script.src = pagefindBase + 'pagefind-ui.js';
    script.onload = boot;
    script.onerror = function () {
      mount.innerHTML =
        '<p style="font-size:13px;color:#64748b">搜索索引尚未生成：本地请先执行 <code>npm run build</code>（会运行 Pagefind 索引），再 <code>npm run preview</code> 访问。</p>';
    };
    document.head.appendChild(script);
  })();
</script>

<style is:global>
  .pagefind-host .pagefind-ui__search-input,
  .pagefind-host .pagefind-ui__button {
    border-radius: 0.5rem;
  }

  /* 小于 16px 时 iOS Safari 聚焦输入框会自动放大整页。
     Pagefind 自带样式表的 `.pagefind-ui__search-input.svelte-xxx` 特异性与我们相同、
     且在之后加载，所以这里必须 !important 才能盖住（实测会被算成 21×0.8=16.8px）。 */
  .pagefind-host .pagefind-ui__search-input {
    font-size: 16px !important;
  }

  /* Pagefind UI 自带浅色主题，不会跟随我们的 .dark 类 */
  .dark .pagefind-host .pagefind-ui__search-input,
  .dark .pagefind-host .pagefind-ui__button {
    background-color: #0f172a !important;
    border-color: #334155 !important;
    color: #e2e8f0 !important;
  }

  .dark .pagefind-host .pagefind-ui__message,
  .dark .pagefind-host .pagefind-ui__result-excerpt,
  .dark .pagefind-host .pagefind-ui__result-nested {
    color: #94a3b8;
  }

  .dark .pagefind-host .pagefind-ui__result-title a {
    color: #38bdf8;
  }

  .dark .pagefind-host mark {
    background-color: #1e3a8a;
    color: #e2e8f0;
  }
</style>
