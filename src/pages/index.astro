---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import ChannelNav from '../components/ChannelNav.astro';
import { CHANNELS } from '../lib/channels';
import {
  formatDateTime,
  formatRelative,
  getChannelCounts,
  getChannelItems,
  getDateEntries,
  getItemsByDate,
  getLatestDate,
  health,
  pickByLang,
  sourceSnapshot,
  totalCount,
} from '../lib/items';
import { href } from '../lib/url';

const counts = getChannelCounts();
const latestDate = getLatestDate();
const todayItems = latestDate ? getItemsByDate(latestDate) : [];
const dates = getDateEntries();
const totals = totalCount();
const enabledSources = sourceSnapshot.filter((source) => source.enabled).length;
const updatedLabel = health.updatedAt ? formatDateTime(health.updatedAt) : '尚未抓取';

/** 今日要闻：每频道 3 条中文 + 2 条英文，中英分栏展示而不是混排 */
const headlineSections = CHANNELS.map((channel) => {
  const all = getChannelItems(channel.id);
  return {
    channel,
    zh: pickByLang(all, 'zh', 3),
    en: pickByLang(all, 'en', 2),
  };
});

const zhSections = headlineSections.filter((section) => section.zh.length > 0);
const enSections = headlineSections.filter((section) => section.en.length > 0);
const hasHeadlines = zhSections.length > 0 || enSections.length > 0;

const emptyChannels = CHANNELS.filter((channel) => (counts[channel.id] ?? 0) === 0);
---

<BaseLayout title="Pulse Hub">
  <section class="border-b border-gray-200 dark:border-slate-800 bg-gradient-to-b from-white to-gray-50 dark:from-slate-900 dark:to-slate-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      <p class="text-xs font-medium tracking-widest text-accent-dark dark:text-accent uppercase">
        Headline Aggregator
      </p>
      <h1 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
        行业头条，每天自动聚合
      </h1>
      <p class="mt-4 max-w-2xl text-sm md:text-base leading-relaxed text-gray-600 dark:text-slate-400">
        定时抓取 AI 前沿、技术社区、财经与政策领域的官方 RSS 与开放 API，自动归一化、跨源去重后按天归档。
        本站只保留<strong class="text-gray-800 dark:text-slate-200">标题、短摘要与原文链接</strong>，正文请点击跳转原文。
      </p>

      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div>
          <span class="block text-2xl font-bold font-mono text-gray-900 dark:text-white">{totals}</span>
          <span class="text-xs text-gray-500 dark:text-slate-500">已收录条目</span>
        </div>
        <div>
          <span class="block text-2xl font-bold font-mono text-gray-900 dark:text-white"
            >{enabledSources}</span
          >
          <span class="text-xs text-gray-500 dark:text-slate-500">启用信息源</span>
        </div>
        <div>
          <span class="block text-2xl font-bold font-mono text-gray-900 dark:text-white"
            >{dates.length}</span
          >
          <span class="text-xs text-gray-500 dark:text-slate-500">归档天数</span>
        </div>
        <div>
          <span class="block text-2xl font-bold font-mono text-gray-900 dark:text-white"
            >{todayItems.length}</span
          >
          <span class="text-xs text-gray-500 dark:text-slate-500">今日新增</span>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-gray-500 dark:text-slate-500">
        <span>最近更新 {updatedLabel}</span>
        {health.updatedAt && <span>· {formatRelative(health.updatedAt)}</span>}
        <span>·</span>
        <a href={href('rss.xml')} class="text-accent-dark dark:text-accent font-medium">订阅 RSS</a>
        {latestDate && (
          <>
            <span>·</span>
            <a href={href(`daily/${latestDate}`)} class="text-accent-dark dark:text-accent font-medium">
              {latestDate} 日报
            </a>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">频道</h2>
    <div class="mt-4">
      <ChannelNav counts={counts} />
    </div>
  </section>

  {
    !hasHeadlines ? (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-12">
        <div class="rounded-xl border border-dashed border-gray-300 dark:border-slate-700 p-6 sm:p-10 text-center">
          <p class="text-gray-700 dark:text-slate-300 font-medium">还没有抓取到数据</p>
          <p class="mt-2 text-sm text-gray-500 dark:text-slate-500">
            在本地执行 <code class="font-mono">npm run fetch</code> 抓取一轮，或在 GitHub Actions
            里手动触发一次工作流。
          </p>
        </div>
      </section>
    ) : (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-10">
        <div class="flex flex-wrap items-end justify-between gap-2">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white">今日要闻</h2>
          <p class="text-xs text-gray-500 dark:text-slate-500">
            每个频道中文 3 条、海外 2 条，按源权重挑选；完整列表进频道页
          </p>
        </div>

        <div class="mt-5 grid gap-6 lg:grid-cols-2">
          <div class="space-y-5">
            <h3 class="flex items-center gap-3 text-sm font-semibold text-accent-dark dark:text-accent">
              中文头条
              <span class="h-px flex-1 bg-gray-200 dark:bg-slate-800" />
              <span class="font-mono text-xs font-normal text-gray-400 dark:text-slate-600">
                {zhSections.reduce((sum, section) => sum + section.zh.length, 0)} 条
              </span>
            </h3>
            {
              zhSections.map(({ channel, zh }) => (
                <section class="rounded-xl border border-gray-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900/50">
                  <div class="flex items-center justify-between">
                    <h4 class="flex items-center gap-2 text-base font-semibold text-gray-900 dark:text-slate-100">
                      <span class:list={['w-2 h-2 rounded-full', channel.dot]} />
                      {channel.label}
                    </h4>
                    <a
                      href={href(`channel/${channel.id}`)}
                      class="text-xs font-medium text-accent-dark dark:text-accent"
                    >
                      全部 {counts[channel.id] ?? 0} 条
                    </a>
                  </div>
                  <ul class="mt-2 divide-y divide-gray-100 dark:divide-slate-800">
                    {zh.map((item) => (
                      <ItemCard item={item} />
                    ))}
                  </ul>
                </section>
              ))
            }
            {zhSections.length === 0 && (
              <p class="text-sm text-gray-500 dark:text-slate-500">
                今天还没有中文条目，可能中文源本轮抓取失败，去「来源」页看看状态。
              </p>
            )}
          </div>

          <div class="space-y-5">
            <h3 class="flex items-center gap-3 text-sm font-semibold text-gray-600 dark:text-slate-300">
              海外参考
              <span class="h-px flex-1 bg-gray-200 dark:bg-slate-800" />
              <span class="font-mono text-xs font-normal text-gray-400 dark:text-slate-600">
                {enSections.reduce((sum, section) => sum + section.en.length, 0)} 条
              </span>
            </h3>
            {
              enSections.map(({ channel, en }) => (
                <section class="rounded-xl border border-gray-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900/50">
                  <div class="flex items-center justify-between">
                    <h4 class="flex items-center gap-2 text-base font-semibold text-gray-900 dark:text-slate-100">
                      <span class:list={['w-2 h-2 rounded-full', channel.dot]} />
                      {channel.label}
                    </h4>
                    <a
                      href={href(`channel/${channel.id}`)}
                      class="text-xs font-medium text-accent-dark dark:text-accent"
                    >
                      全部 {counts[channel.id] ?? 0} 条
                    </a>
                  </div>
                  <ul class="mt-2 divide-y divide-gray-100 dark:divide-slate-800">
                    {en.map((item) => (
                      <ItemCard item={item} showSummary={false} />
                    ))}
                  </ul>
                </section>
              ))
            }
            {enSections.length === 0 && (
              <p class="text-sm text-gray-500 dark:text-slate-500">暂无海外条目。</p>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    emptyChannels.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-8">
        <p class="text-xs text-gray-500 dark:text-slate-500 leading-relaxed">
          暂无论文/政策数据的频道：
          {emptyChannels.map((channel) => channel.label).join('、')}
          。政策类来源需自建 RSSHub 实例后开启（见「来源」页说明），财经来源需在仓库 Secrets
          配置 API Key。
        </p>
      </section>
    )
  }

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">日报归档</h2>
      <a href={href('daily')} class="text-xs font-medium text-accent-dark dark:text-accent">
        全部 {dates.length} 天
      </a>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        dates.slice(0, 10).map((entry) => (
          <a
            href={href(`daily/${entry.date}`)}
            class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs text-gray-700 hover:border-accent/60 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
          >
            <span class="font-mono">{entry.date}</span>
            <span class="ml-2 text-gray-400 dark:text-slate-500">{entry.count}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
