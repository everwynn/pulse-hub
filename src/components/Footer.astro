---
import { href } from '../lib/url';

const year = new Date().getFullYear();
const { updatedAt } = Astro.props as { updatedAt?: string };
---

<footer class="border-t border-gray-200 dark:border-slate-800 mt-16 bg-gray-50/50 dark:bg-transparent">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 space-y-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
      <p class="text-gray-600 dark:text-slate-400 text-sm">
        &copy; {year} Pulse Hub · 行业头条聚合 · Built with
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent-dark dark:text-accent font-medium">Astro</a
        >
      </p>
      <div class="flex items-center gap-4 text-sm">
        <a href={href('daily')} class="text-gray-600 dark:text-slate-400">日报归档</a>
        <a href={href('sources')} class="text-gray-600 dark:text-slate-400">信息来源</a>
        <a href={href('rss.xml')} class="text-gray-600 dark:text-slate-400">RSS</a>
        <a href={href('about')} class="text-gray-600 dark:text-slate-400">关于与合规</a>
      </div>
    </div>
    <p class="text-xs text-gray-500 dark:text-slate-500 leading-relaxed">
      本站仅收录各信息源的<strong>标题、短摘要与原文链接</strong>，不存储、不转载正文；所有内容版权归原作者与来源站点所有，点击标题即跳转原文。
      {updatedAt ? `数据更新于 ${updatedAt}。` : ''}
    </p>
  </div>
</footer>
