---
import ThemeToggle from './ThemeToggle.astro';
import { href } from '../lib/url';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: href('/'), label: '首页' },
  { href: href('channel/ai'), label: 'AI' },
  { href: href('channel/tech'), label: '技术' },
  { href: href('channel/finance'), label: '财经' },
  { href: href('channel/policy'), label: '政策' },
  { href: href('daily'), label: '日报' },
  { href: href('sources'), label: '来源' },
];

const isActive = (target: string) => {
  if (target === href('/')) return currentPath === target;
  return currentPath.startsWith(target);
};
---

<header class="glass border-b border-gray-200 dark:border-slate-800 sticky top-0 z-50 shadow-sm dark:shadow-none">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a
      href={href('/')}
      class="text-xl font-bold text-gray-900 dark:text-white hover:text-accent-dark dark:hover:text-accent flex items-center gap-2 shrink-0"
    >
      <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 12h4l3-7 4 14 3-9 1 2h3"></path>
      </svg>
      Pulse Hub
    </a>

    <div class="flex items-center gap-4">
      <ul class="hidden lg:flex items-center gap-6">
        {
          navLinks.map(({ href: link, label }) => (
            <li>
              <a
                href={link}
                class:list={[
                  'text-sm font-medium',
                  isActive(link)
                    ? 'text-accent-dark dark:text-accent'
                    : 'text-gray-700 dark:text-slate-300 hover:text-accent-dark dark:hover:text-white',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={href('search')}
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-gray-600 dark:text-slate-300 hover:text-accent-dark dark:hover:text-accent"
        aria-label="搜索"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>

      <div class="hidden lg:block">
        <ThemeToggle />
      </div>

      <button
        id="menu-toggle"
        class="lg:hidden -mr-2 inline-flex h-10 w-10 items-center justify-center rounded-lg text-gray-700 dark:text-slate-300 hover:text-accent"
        aria-label="打开导航菜单"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 dark:border-slate-800">
    <ul class="px-4 sm:px-6 py-4 space-y-3">
      {
        navLinks.map(({ href: link, label }) => (
          <li>
            <a
              href={link}
              class:list={[
                'block rounded-lg py-2 text-sm font-medium',
                isActive(link)
                  ? 'text-accent-dark dark:text-accent'
                  : 'text-gray-700 dark:text-slate-300 hover:text-accent-dark dark:hover:text-white',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="pt-3 border-t border-gray-200 dark:border-slate-700">
        <div class="flex items-center gap-3">
          <span class="text-sm text-gray-700 dark:text-slate-400 font-medium">主题切换</span>
          <ThemeToggle />
        </div>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
  });
</script>
