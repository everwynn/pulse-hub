---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatDateTime, health } from '../lib/items';
import { href } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const SITE_NAME = 'Pulse Hub';
const {
  title,
  description = '行业头条聚合站：定时抓取 AI 前沿、技术社区、财经与政策的官方信息源，只保留标题、摘要与原文链接。',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const updatedAt = health.updatedAt ? formatDateTime(health.updatedAt) : '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f9fafb" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- 图标：SVG 优先；PNG/ICO 给 Safari 等对 SVG favicon 支持不完整的浏览器回退；
         apple-touch-icon 供 iOS 添加到主屏幕（满版方形，圆角由系统裁） -->
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('favicon-32.png')} />
    <link rel="icon" href={href('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href={href('apple-touch-icon.png')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Pulse Hub 订阅"
      href={href('rss.xml')}
    />
    <title>{fullTitle}</title>

    <!-- 主题初始化：必须在首帧前决定，避免闪烁。
         三态：light | dark | system（默认 system），只改 class 与 color-scheme，不做任何渐变 ——
         原来的全局 300ms 颜色过渡会让整页同时“发灰”，切换到 View Transitions 快照后已移除。 -->
    <script is:inline>
      (function () {
        var KEY = 'theme';
        var MODES = ['light', 'dark', 'system'];
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: dark)');

        function readMode() {
          try {
            var saved = localStorage.getItem(KEY);
            if (MODES.indexOf(saved) !== -1) return saved;
          } catch (err) {
            /* 隐私模式下 localStorage 不可读，按跟随系统处理 */
          }
          return 'system';
        }

        function apply(mode, persist) {
          var resolved = mode === 'system' ? (media.matches ? 'dark' : 'light') : mode;
          root.classList.toggle('dark', resolved === 'dark');
          root.setAttribute('data-theme-mode', mode);
          root.style.colorScheme = resolved;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', resolved === 'dark' ? '#020617' : '#f9fafb');
          if (persist) {
            try {
              localStorage.setItem(KEY, mode);
            } catch (err) {
              /* 写不进去就只影响本次会话 */
            }
          }
        }

        // 供 ThemeToggle 组件调用
        window.__pulseTheme = { apply: apply, readMode: readMode };
        apply(readMode(), false);

        // 选择“跟随系统”时，系统主题变化要跟着变
        media.addEventListener('change', function () {
          if (readMode() === 'system') apply('system', false);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer updatedAt={updatedAt} />
  </body>
</html>
