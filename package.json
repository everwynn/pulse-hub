{
  "name": "pulse-hub",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "行业头条聚合站：定时抓取官方 RSS 与开放 API，静态部署到 GitHub Pages",
  "engines": {
    "node": ">=18.17.1"
  },
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "fetch:dry": "node scripts/fetch.mjs --dry-run --limit 3",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "node --test tests/",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/tailwind": "^5.1.5",
    "@astrojs/vue": "^4.5.3",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^4.16.19",
    "fast-xml-parser": "^4.5.0",
    "p-limit": "^6.1.0",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "pagefind": "^1.2.0"
  }
}
